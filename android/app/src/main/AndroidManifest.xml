<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗：唯一能做到「纯加光叠在任何界面上」的形态 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 音频来源①：麦克风（零摩擦默认） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 音频来源②：内部音频（Android 10+，走 MediaProjection） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 常驻通知（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 音频焦点与参数 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 息屏时暂停渲染用 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightPillar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前台服务常驻。type 同时声明 microphone 与 mediaProjection：
             · 只用麦克风时按 microphone 启动
             · 切到内部音频时按 mediaProjection 启动
          两个都声明是因为用户在设置页里可以随时切换音频来源。
        -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

    </application>

</manifest>
