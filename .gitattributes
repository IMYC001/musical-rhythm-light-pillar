# 统一换行符：源码用 LF，Windows 批处理用 CRLF
* text=auto eol=lf

*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.exe   binary
*.dll   binary
*.ico   binary
*.png   binary
*.bmp   binary
*.apk   binary

# 生成物，diff 没意义
windows/src/data_themes.h linguist-generated=true
windows/tools/ref-analyzer.js linguist-generated=true
